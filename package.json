{
  "name": "aulos",
  "version": "5.1.0",
  "description": "[DEPRECATED] Electron 壳已弃用, 桌面端由 Tauri 壳承担 (src-tauri/)。保留仅供参照, 不再随版本发布",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "test:web": "node --test tests/web/*.test.js"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "electron": "^44.4.1",
    "electron-builder": "^26.0.12",
    "jsdom": "^29.1.1"
  },
  "build": {
    "appId": "com.aulos.desktop",
    "productName": "Aulos",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "static/icon.png"
    ],
    "extraResources": [
      {
        "from": "build/server",
        "to": "server",
        "filter": [
          "aulos-server*"
        ]
      },
      {
        "from": "pets",
        "to": "pets"
      }
    ],
    "mac": {
      "icon": "build/icon-1024.png",
      "category": "public.app-category.developer-tools",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "icon": "src-tauri/icons/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
