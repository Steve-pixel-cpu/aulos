.env
prompt_dev

# Electron / Node
node_modules/
dist/
build/
src-tauri/target
src-tauri/Debug


# Rust / Tauri build artifacts
src-tauri/gen/
cargo-*.log


# 日志与临时产物（统一收口, 覆盖 tauri/uvicorn/cargo 各命名）
*.log

# 测试缓存与临时存储
.pytest_cache/
test_storage/

# 演示视频工程: 录制原片/渲染产物不入库
demo/raw/
demo/video/out/

# 打包中间产物: 由 build-exe.cmd 从 build/server/ 复制, 不入库
src-tauri/server/

# 宠物资产打包中间产物: 由 build-exe.cmd 从 pets/ 复制(仓库根 pets/ 是源)
src-tauri/pets/

# 更新签名私钥: 绝不入库。丢了老用户就收不到自动更新, 保管好
.tauri/

# evals 运行产物 (基线 baseline.json 与夹具 tasks/ 随仓库提交)
evals/.runs/
evals/results/
evals/report.md

# 根目录临时构建日志 (cargo/tauri/uvicorn 调试输出)
/cargo-*.log
/tauri-build*.log
/uvicorn_*.log
demo/video/public/raw/

# 本地会话诊断数据（历史遗留目录, 不入库）
docs/superpowers/

# agent 并行工作区 (git worktree, 由 using-git-worktrees 技能管理)
.worktrees/
