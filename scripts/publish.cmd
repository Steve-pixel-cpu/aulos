@echo off
REM ============================================================
REM Publish a release that existing installs can auto-update to.
REM Prereq: build-exe.cmd tauri <ver> has been run (dist\ populated).
REM
REM Branch protection: main is a protected branch (PR + approve + squash only).
REM Land the version bump via PR first, then run this script on merged,
REM up-to-date main - it hard-fails otherwise (no tagging stale branches).
REM Pushing the v* tag triggers CI (release.yml) to build Win/macOS/Linux and
REM create the GitHub Release; the gh block below is the local fallback that
REM publishes the Windows assets immediately (CI later clobbers/normalizes).
REM
REM   scripts\publish.cmd <ver> [notes]
REM   e.g. scripts\publish.cmd 3.4.0 "fix a, add b"
REM
REM Steps:
REM   1. sanity-check dist\latest.json (generated by scripts\make-latest.js)
REM      and the signed installer + .sig
REM   2. git tag v<ver> and push it
REM   3. gh release create, uploading installer + .sig + latest.json
REM      Asset names are fixed by convention; the app's updater endpoint is
REM      releases/latest/download/latest.json which always resolves to the
REM      newest release.
REM Prereq: gh CLI logged in (gh auth login). Without gh, manual steps are
REM printed instead.
REM NOTE: keep this file ASCII-only (cmd parses it with the ANSI codepage).
REM ============================================================
setlocal enabledelayedexpansion
cd /d %~dp0..

set "VER=%~1"
if "%VER%"=="" (
  echo Usage: scripts\publish.cmd ^<ver^> [notes]
  echo e.g.   scripts\publish.cmd 3.4.0 "fix a, add b"
  exit /b 1
)

REM Branch-protection guard: the tag must sit on merged, up-to-date main.
REM (Version-bump PRs are squash-merged, so main's SHA only matches after a pull.)
git fetch origin main
if errorlevel 1 exit /b 1
for /f %%B in ('git rev-parse --abbrev-ref HEAD') do set "BRANCH=%%B"
for /f %%B in ('git rev-parse HEAD') do set "LOCALSHA=%%B"
for /f %%B in ('git rev-parse origin/main') do set "REMOTESHA=%%B"
if /i not "%BRANCH%"=="main" (
  echo [publish] Not on main - current branch is %BRANCH%.
  echo [publish]   Releases must be tagged on merged main.
  echo [publish]   Run: git checkout main, then: git pull origin main
  exit /b 1
)
if not "%LOCALSHA%"=="%REMOTESHA%" (
  echo [publish] Local main is out of sync with origin/main - refusing to tag a stale base.
  echo [publish]   Run: git pull origin main
  exit /b 1
)

REM 产物名单点化: 前缀 = tauri.conf.json 的 productName（与 make-latest.js 一致）
set "PNAME="
for /f "tokens=2 delims=:" %%A in ('findstr /c:"productName" src-tauri\tauri.conf.json') do set "PNAME=%%A"
set "PNAME=%PNAME:,=%"
set "PNAME=%PNAME:"=%"
set "PNAME=%PNAME: =%"
if not defined PNAME (
  echo [publish] cannot read productName from src-tauri\tauri.conf.json
  exit /b 1
)
set "EXE=%PNAME%_%VER%_x64-setup.exe"
set "LATEST=dist\latest.json"

if not exist "%LATEST%" (
  echo [publish] %LATEST% missing - run first: build-exe.cmd tauri %VER% ^&^& node scripts\make-latest.js
  exit /b 1
)
findstr /c:"\"version\": \"%VER%\"" "%LATEST%" >nul
if errorlevel 1 (
  echo [publish] Version mismatch in %LATEST% vs %VER% - re-run: node scripts\make-latest.js
  exit /b 1
)
if not exist "dist\%EXE%" (
  echo [publish] Missing dist\%EXE%
  exit /b 1
)
if not exist "dist\%EXE%.sig" (
  echo [publish] Missing dist\%EXE%.sig - releases MUST ship the signature, or existing installs cannot auto-update to this version
  exit /b 1
)

echo [publish] Pushing tag v%VER% ...
git rev-parse -q --verify "refs/tags/v%VER%" >nul 2>&1
if not errorlevel 1 (
  echo [publish] Tag v%VER% already exists - refusing to overwrite ^(no more "tag -f"^).
  echo [publish]   Tags map 1:1 to releases and are immutable: bump the version instead.
  exit /b 1
)
git tag v%VER%
git push origin v%VER%
if errorlevel 1 exit /b 1
echo [publish] Tag pushed. CI ^(release.yml^) is now building Win/macOS/Linux and
echo [publish]   will create/normalize the release. Track it with:
echo [publish]     gh run list --workflow Release --limit 1
echo [publish]     gh release view v%VER%

where gh >nul 2>&1
if errorlevel 1 goto :manual
gh auth status >nul 2>&1
if errorlevel 1 (
  echo [publish] gh is not logged in. Run: gh auth login
  echo [publish] Or set the GH_TOKEN environment variable, then re-run this script.
  goto :manual
)

set "NOTES=%~2"
echo [publish] Generating release notes from git log ...
if "%NOTES%"=="" (
  REM Default: auto-generate categorized notes from git log (same
  REM generator as CI: scripts/make-release-notes.js)
  node scripts\make-release-notes.js --tag v%VER% --out dist\release-notes.md
  if errorlevel 1 exit /b 1
  set "NOTES_FILE=--notes-file dist\release-notes.md"
) else (
  REM Manual notes win
  set "NOTES_FILE=--notes !NOTES!"
)

echo [publish] Creating GitHub release v%VER% and uploading assets ...
gh release create v%VER% "dist\%EXE%" "dist\%EXE%.sig" "%LATEST%" --title "Aulos v%VER%" !NOTES_FILE!
if errorlevel 1 (
  echo [publish] gh failed - the release may already exist. Try:
  echo [publish]   gh release edit v%VER% !NOTES_FILE!
  echo [publish]   gh release upload v%VER% dist\%EXE% dist\%EXE%.sig dist\latest.json --clobber
  exit /b 1
)
echo [publish] Done. Users on older versions will get the update on next app start.
goto :eof

:manual
echo [publish] gh CLI not found. Publish manually:
echo   1. Open https://github.com/Steve-pixel-cpu/aulos/releases/new?tag=v%VER%
echo   2. Upload all three files: dist\%EXE%  dist\%EXE%.sig  dist\latest.json
echo   3. Title it "aulos v%VER%" and publish
exit /b 1
